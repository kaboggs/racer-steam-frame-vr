{
  "controller_type": "frame_controller",
  "name": "Racer Frame controls",
  "description": "Local Racer source port",
  "bindings": {
    "/actions/racer": {
      "sources": [
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/racer/in/stick"
            },
            "click": {
              "output": "/actions/racer/in/stick_click"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/racer/in/trigger"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/racer/in/grip"
            }
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/racer/in/primary"
            }
          }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/racer/in/secondary"
            }
          }
        },
        {
          "path": "/user/hand/left/input/application_menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/racer/in/menu"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/racer/in/stick"
            },
            "click": {
              "output": "/actions/racer/in/stick_click"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/racer/in/trigger"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/racer/in/grip"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/racer/in/primary"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/racer/in/secondary"
            }
          }
        }
      ]
    }
  }
}  

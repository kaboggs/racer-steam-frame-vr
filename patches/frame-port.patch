+// Built-in tracks use the game's original menu implementation, retaining its
+// artwork setup/teardown lifecycle. Custom tracks keep the fork's extended menus.
+static bool frame_stock_menu(swrObjHang *hang) {
+    return hang && (unsigned char)hang->track_index < 25;
+}
+static void frame_course_info_menu(swrObjHang *hang) {
+    if (frame_stock_menu(hang)) {
+        static bool said = false;
+        if (!said) { fprintf(hook_log, "[Frame transition] original stock course-info menu\n"); fflush(hook_log); said = true; }
+        hook_call_original((void(__cdecl *)(swrObjHang *))swrRace_CourseInfoMenu_ADDR, hang);
+    } else swrRace_CourseInfoMenu_delta(hang);
+}
+static void frame_main_menu(swrObjHang *hang) {
+    if (frame_stock_menu(hang))
+        hook_call_original((void(__cdecl *)(swrObjHang *))swrRace_MainMenu_ADDR, hang);
+    else swrRace_MainMenu_delta(hang);
+}
+static void frame_course_selection_menu() {
+    if (frame_stock_menu(g_objHang2))
+        hook_call_original((void(__cdecl *)())swrRace_CourseSelectionMenu_ADDR);
+    else swrRace_CourseSelectionMenu_delta();
+}
